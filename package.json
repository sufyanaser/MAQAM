{
  "name": "maqam-lab",
  "productName": "MAQAM Lab",
  "private": true,
  "version": "0.2.0",
  "description": "Arabic maqam and microtonal scale analyzer for desktop.",
  "author": "Sufyan Nasser Ali",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:3000 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron .\"",
    "icons": "node scripts/generate-icons.mjs",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "desktop:dir": "npm run build && electron-builder --dir",
    "desktop:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "react-dom": "^19.2.4",
    "react": "^19.2.4",
    "lucide-react": "^0.563.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.nas.maqamlab",
    "productName": "MAQAM Lab",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "MAQAM-Lab-${version}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MAQAM Lab"
    }
  }
}
